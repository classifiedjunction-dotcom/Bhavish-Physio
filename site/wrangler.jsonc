{
  // Public website: server-rendered pages built from content in D1.
  "name": "physio-site",
  "main": "src/index.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "physio-db",
      "database_id": "aafafad8-a891-4e6a-9a45-0217ba03f25a",
      "migrations_dir": "../db/migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "MEDIA",
      "id": "53534c48123c41b1964101a4a841859e"
    }
  ],
  "observability": {
    "enabled": true
  }
}
